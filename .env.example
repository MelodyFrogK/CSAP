# ── LLM 공급자 선택 ────────────────────────────────────────────
# anthropic  : Anthropic API 키 사용
# openai     : OpenAI API 키 사용
# claude_cli : 별도 API 키 없이, 설치·인증된 Claude Code(claude CLI) 재사용
# echo       : 테스트용 더미, 키 없이 동작(실제 분석 아님)
CSAP_LLM_PROVIDER=claude_cli

# Anthropic (Claude) — CSAP_LLM_PROVIDER=anthropic 일 때
ANTHROPIC_API_KEY=
CSAP_ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI — CSAP_LLM_PROVIDER=openai 일 때
OPENAI_API_KEY=
CSAP_OPENAI_MODEL=gpt-4o

# Claude Code CLI — CSAP_LLM_PROVIDER=claude_cli 일 때 (별도 키 불필요)
CSAP_CLAUDE_CLI_BINARY=claude
# 빈 값이면 Claude Code 기본 모델 사용 (예: claude-sonnet-4-6, claude-haiku-4-5)
CSAP_CLAUDE_CLI_MODEL=
CSAP_CLAUDE_CLI_TIMEOUT=180

# ── 동작 설정 ─────────────────────────────────────────────────
# 문서에서 각 명세항목에 붙일 관련 청크 수
CSAP_TOP_K=6
# 문서 청크 길이(문자)
CSAP_CHUNK_SIZE=1200
CSAP_CHUNK_OVERLAP=200
# LLM 동시 처리 수
CSAP_CONCURRENCY=4
