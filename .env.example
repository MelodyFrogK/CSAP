# ── LLM 공급자 선택 ────────────────────────────────────────────
# anthropic | openai | echo(테스트용, 키 없이 동작)
CSAP_LLM_PROVIDER=anthropic

# Anthropic (Claude)
ANTHROPIC_API_KEY=
CSAP_ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI
OPENAI_API_KEY=
CSAP_OPENAI_MODEL=gpt-4o

# ── 동작 설정 ─────────────────────────────────────────────────
# 문서에서 각 명세항목에 붙일 관련 청크 수
CSAP_TOP_K=6
# 문서 청크 길이(문자)
CSAP_CHUNK_SIZE=1200
CSAP_CHUNK_OVERLAP=200
# LLM 동시 처리 수
CSAP_CONCURRENCY=4
